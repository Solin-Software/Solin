+
+/* Keep one endpoint period inside the existing A/V latency allowance. The
+ * remaining window is scheduling headroom, independent of source packet size:
+ * small tempo packets need the same jitter margin as large decoded packets. */
+static uint32_t monitor_preroll_frames(uint32_t sample_rate, REFERENCE_TIME period)
+{
+	if (period <= 0 || period >= MAX_AV_DELAY_NS / 100)
+		return 0;
+	uint64_t reserve_ns = MAX_AV_DELAY_NS - (uint64_t)period * 100;
+	return (uint32_t)util_mul_div64(reserve_ns, sample_rate, 1000000000ULL);
+}
+
+/* The caller holds playback_mutex. EOF deliberately does not reset the endpoint. */
+static HRESULT reset_playback(struct audio_monitor *monitor)
+{
+	HRESULT hr = monitor->client->lpVtbl->Stop(monitor->client);
+	if (FAILED(hr)) {
+		warn("%s: Stop failed: %08lX", __FUNCTION__, hr);
+		return hr;
+	}
+	hr = monitor->client->lpVtbl->Reset(monitor->client);
+	if (FAILED(hr)) {
+		warn("%s: Reset failed: %08lX", __FUNCTION__, hr);
+		return hr;
+	}
+	monitor->started = false;
+	monitor->last_submit_time = 0;
+	monitor->last_submit_duration = 0;
+	return S_OK;
+}
+
+/* A drained endpoint after a real pause/starvation needs a fresh reserve.
+ * Padding alone is quantized and is not evidence of an underrun. */
+static HRESULT reset_if_idle(struct audio_monitor *monitor, uint32_t pad, uint64_t now)
+{
+	if (monitor->started && !pad && monitor->last_submit_time &&
+	    now - monitor->last_submit_time >
+		    monitor->last_submit_duration +
+			    util_mul_div64(monitor->preroll_frames, 1000000000ULL, monitor->sample_rate))
+		return reset_playback(monitor);
+	return S_OK;
+}
+
+/* Submit once: the startup reserve precedes PCM, never replaces active samples.
+ * A very large packet may leave less room for the reserve; never overrun the
+ * actual endpoint capacity. */
+static HRESULT write_audio(struct audio_monitor *monitor, const float *data, uint32_t frames, uint32_t pad, bool muted)
+{
+	BYTE *output;
+	if (!frames)
+		return S_OK;
+	if (frames > monitor->buffer_frames || pad > monitor->buffer_frames - frames)
+		return AUDCLNT_E_BUFFER_TOO_LARGE;
+	uint32_t reserve = monitor->started ? 0 : min(monitor->preroll_frames, monitor->buffer_frames - frames - pad);
+	uint32_t total = frames + reserve;
+	HRESULT hr = monitor->render->lpVtbl->GetBuffer(monitor->render, total, &output);
+	if (FAILED(hr))
+		return hr;
+	if (!muted) {
+		memset(output, 0, (size_t)reserve * monitor->channels * sizeof(float));
+		memcpy(output + (size_t)reserve * monitor->channels * sizeof(float), data,
+		       (size_t)frames * monitor->channels * sizeof(float));
+	}
+	hr = monitor->render->lpVtbl->ReleaseBuffer(monitor->render, total, muted ? AUDCLNT_BUFFERFLAGS_SILENT : 0);
+	if (FAILED(hr))
+		return hr;
+	if (!monitor->started) {
+		hr = monitor->client->lpVtbl->Start(monitor->client);
+		if (FAILED(hr)) {
+			warn("%s: Start failed: %08lX", __FUNCTION__, hr);
+			return hr;
+		}
+		monitor->started = true;
+	}
+	monitor->last_submit_time = os_gettime_ns();
+	monitor->last_submit_duration = util_mul_div64(total, 1000000000ULL, monitor->sample_rate);
+	return S_OK;
 }
 
