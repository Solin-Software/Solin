+		mp_media_tempo_drain(m);
+	}
+	if (m->tempo_queue.size) {
+		struct mp_tempo_frame tail;
+		deque_peek_back(&m->tempo_queue, &tail, sizeof(tail));
+		int64_t end = tail.pts + tempo_output_media_ns(m, tail.frame->nb_samples, tail.frame->sample_rate);
+		if (end > boundary)
+			boundary = end;
+	}
+	m->tempo_pending_speed = speed;
+	m->tempo_switch_pts = boundary;
+	m->tempo_rate_pending = true;
