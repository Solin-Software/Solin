# Solin hub configuration. Copy to hub.env and fill in. Generate secrets with: openssl rand -hex 32

# --- Addresses -------------------------------------------------------------------------------
# Base domain. Halls are served at https://<hall>.HUB_DOMAIN/. DNS records needed:
#   HUB_DOMAIN    A (and AAAA)  -> the VPS
#   *.HUB_DOMAIN  A (and AAAA)  -> the VPS
# No domain? Use sslip.io, which resolves <anything>.<ip-with-dashes>.sslip.io to that IP, so
# Let's Encrypt works with no DNS setup at all. For public IP 203.0.113.10:
#   HUB_DOMAIN=203-0-113-10.sslip.io      (halls: hall-abc123.203-0-113-10.sslip.io)
HUB_DOMAIN=hub.example.org
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=admin@example.org

# Addresses coturn relays media from (it must not pick Docker bridge addresses).
#  PUBLIC_IP   public IPv4 of the VPS.
#  PRIVATE_IP  only on clouds with 1:1 NAT (Google Cloud, Oracle, AWS): the VM's own address
#              from `ip -4 addr`. Leave empty when the public IPv4 is on the interface itself
#              (Hetzner, OVH, DigitalOcean, most VPSs).
#  PUBLIC_IP6  public IPv6 of the VPS (`ip -6 addr show scope global`); recommended, empty = no IPv6 relay.
PUBLIC_IP=203.0.113.10
PRIVATE_IP=
PUBLIC_IP6=

# --- Tunnel (frps) -----------------------------------------------------------------------------
# Port the halls' frpc connects to (open it in the firewall, TCP).
FRP_BIND_PORT=7000
# Shared by every hall (goes into their frpc.toml). Per-hall keys are in halls.json.
FRP_TOKEN=change-me-openssl-rand-hex-32
# frps admin API, loopback only (the ask service reads hall status from it).
FRP_ADMIN_PORT=7500
FRP_ADMIN_PASSWORD=change-me-openssl-rand-hex-32
# Loopback ports frps binds for hall tunnels; each hall's "port" in halls.json must be in range.
# Not exposed to the internet, no firewall rule needed.
HALL_PORT_MIN=20000
HALL_PORT_MAX=20999

# --- Control service (ask) ---------------------------------------------------------------------
ASK_PORT=7400
HALLS_FILE=/hub/halls.json

# --- TURN (coturn) ----------------------------------------------------------------------------
# Shared with the halls (Solin hands it to Galene, which mints time-limited credentials).
TURN_SECRET=change-me-openssl-rand-hex-32
TURN_PORT=3478
# UDP relay port range (open it in the firewall). ~1 port per relayed attendee stream.
TURN_MIN_PORT=49160
TURN_MAX_PORT=49999
# Max simultaneous allocations on this hub.
TURN_TOTAL_QUOTA=1000
