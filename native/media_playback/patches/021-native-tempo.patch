+/* A rate change takes effect at the end of the input already accepted by
+ * the current graph. Draining retains its tail and the queued output. */
+static void mp_media_request_speed(mp_media_t *m, int speed)
+{
+	if (!m->tempo_rate_pending && speed == m->speed)
+		return;
+	if (m->tempo_rate_pending) {
+		m->tempo_pending_speed = speed;
+		return;
