# Local development hub (one machine, no DNS). Run from deploy/hub:
#   docker compose --env-file local/hub.env.local up -d --build
# These two are read by docker compose itself (because of --env-file) to pick the local files:
COMPOSE_PROJECT_NAME=solin-hub-local
HUB_ENV_FILE=local/hub.env.local
CADDYFILE=./local/Caddyfile

# *.localhost resolves to 127.0.0.1 (curl, browsers): https://hall-a.hub.localhost:8443/
HUB_DOMAIN=hub.localhost
ACME_EMAIL=dev@example.org
HTTP_PORT=8880
HTTPS_PORT=8443
PUBLIC_IP=
PRIVATE_IP=
PUBLIC_IP6=

FRP_BIND_PORT=7000
FRP_TOKEN=local-frp-token
FRP_ADMIN_PORT=7500
FRP_ADMIN_PASSWORD=local-admin
HALL_PORT_MIN=20000
HALL_PORT_MAX=20099

ASK_PORT=7400
HALLS_FILE=/hub/local/halls.json

TURN_SECRET=local-turn-secret
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49260
TURN_TOTAL_QUOTA=100
