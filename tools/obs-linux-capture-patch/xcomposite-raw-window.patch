diff --git a/plugins/linux-capture/xcomposite-input.c b/plugins/linux-capture/xcomposite-input.c
index 174b794..53c645e 100644
--- a/plugins/linux-capture/xcomposite-input.c
+++ b/plugins/linux-capture/xcomposite-input.c
@@ -297,6 +297,17 @@ xcb_window_t xcomp_find_window(xcb_connection_t *conn, Display *disp, const char
 		goto cleanup;
 	}
 
+	// Solin patch: a "raw:<xid>" spec captures an exact window id directly,
+	// bypassing the _NET_CLIENT_LIST top-level search. This lets us target a
+	// window that has been reparented as a native child (so it is not a managed
+	// top-level window) — e.g. an embedded WebKitGTK browser surface. Accepts
+	// decimal or 0x-hex. The compositing path (redirect + name_window_pixmap) is
+	// window-agnostic, so a child id captures fine once resolved here.
+	if (strncmp(str, "raw:", 4) == 0) {
+		ret = (xcb_window_t)strtoul(str + 4, NULL, 0);
+		goto cleanup;
+	}
+
 	ret = convert_encoded_window_id(str, &wname, &wcls);
 
 	// first try to find a match by the window-id
@@ -473,6 +484,14 @@ void watcher_process(xcb_generic_event_t *ev)
 	case XCB_MAP_NOTIFY:
 		win = ((xcb_map_notify_event_t *)ev)->event;
 		break;
+	// Solin patch: a reparent (e.g. the app parking the captured window into an
+	// off-screen keep-alive host to survive a panel switch) frees the redirected
+	// pixmap. Stock code has no case for it, so recovery waited up to
+	// FIND_WINDOW_INTERVAL (2s) → a visible black flash. Treat it as a change so
+	// the pixmap is rebuilt on the very next frame (near-instant, no flash).
+	case XCB_REPARENT_NOTIFY:
+		win = ((xcb_reparent_notify_event_t *)ev)->window;
+		break;
 	case XCB_EXPOSE:
 		win = ((xcb_expose_event_t *)ev)->window;
 		break;
