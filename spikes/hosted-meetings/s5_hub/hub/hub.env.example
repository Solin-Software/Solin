# Base domain; needs DNS records:  HUB_DOMAIN -> PUBLIC_IP  and  *.HUB_DOMAIN -> PUBLIC_IP
HUB_DOMAIN=hub.example.org
ACME_EMAIL=you@example.org
# Oracle VMs are 1:1 NATed: PRIVATE_IP is the VNIC address (ip -4 addr), PUBLIC_IP the reserved public IP
PUBLIC_IP=203.0.113.10
PRIVATE_IP=10.0.0.10
# Shared with halls (frpc) - generate: openssl rand -hex 24
FRP_TOKEN=change-me
# Shared with the halls' LiveKit (turn_servers.secret) - generate: openssl rand -hex 24
TURN_SECRET=change-me
# frps admin API (bound to 127.0.0.1)
FRP_DASH_PASSWORD=change-me
# "http" for local testing without certificates, "https" on the VM
SCHEME=https
